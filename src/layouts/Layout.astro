---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import NavbarDemo from '../components/ui/NavbarDemo.tsx';
import SocialLink from '../components/SocialLink';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video' | 'product';
  url?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  youtubeVideoId?: string;
  videoUrl?: string;
  hideNavigation?: boolean;
  hideFooter?: boolean;
  productData?: {
    name?: string;
    description?: string;
    price?: string;
    currency?: string;
    availability?: string;
    image?: string;
  };
}

const {
  title,
  description,
  image,
  type,
  url,
  robots,
  publishedTime,
  modifiedTime,
  author,
  youtubeVideoId,
  videoUrl,
  hideNavigation = false,
  hideFooter = false,
  productData,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P3XJGXL5');</script>
    <!-- End Google Tag Manager -->

    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '1398654025074894');
      fbq('track', 'PageView');
    </script>
    <!-- End Meta Pixel Code -->

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      url={url}
      robots={robots}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      youtubeVideoId={youtubeVideoId}
      videoUrl={videoUrl}
      productData={productData}
    />
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon_naturerota.svg" />
    <link rel="apple-touch-icon" href="/icon_naturerota.svg" />
    <link rel="mask-icon" href="/icon_naturerota.svg" color="#123A2B" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9KWR7HV8NS"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-9KWR7HV8NS');
    </script>
  </head>
  <body class="min-h-screen text-gray-900 antialiased" style="background-color: #FFF8F2;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P3XJGXL5"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Meta Pixel Code (noscript) -->
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1398654025074894&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code (noscript) -->

    {!hideNavigation && <NavbarDemo client:load />}

    <main>
      <slot />
    </main>

    {!hideFooter && (
    <footer class="border-t border-gray-200 mt-auto bg-gray-50">
      <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Navegação</h3>
            <ul class="space-y-2">
              <li>
                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
              </li>
              <li>
                <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
              </li>
              <li>
                <a href="/#sobre-nos" class="text-gray-600 hover:text-gray-900">Quem Somos</a>
              </li>
              <li>
                <a href="/#produtos" class="text-gray-600 hover:text-gray-900">Produtos</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Redes Sociais</h3>
            <ul class="space-y-2">
              <li>
                <SocialLink client:load platform="instagram" url="https://instagram.com/naturerota" className="text-gray-600 hover:text-gray-900">
                  Instagram
                </SocialLink>
              </li>
              <li>
                <SocialLink client:load platform="youtube" url="https://www.youtube.com/@naturerota" className="text-gray-600 hover:text-gray-900">
                  YouTube
                </SocialLink>
              </li>
              <li>
                <a href="https://www.tiktok.com/@naturerota" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  TikTok
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/profile.php?id=61573134423986" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  Facebook
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Legal</h3>
            <ul class="space-y-2">
              <li>
                <a href="/politica-de-privacidade" class="text-gray-600 hover:text-gray-900">
                  Política de Privacidade
                </a>
              </li>
              <li>
                <a href="/termos-de-uso" class="text-gray-600 hover:text-gray-900">
                  Termos de Uso
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Contato</h3>
            <p class="text-gray-600 text-sm mb-3">
              Entre em contato conosco através das nossas redes sociais ou por e-mail:
            </p>
            <p class="text-gray-700 text-sm">
              <a href="mailto:naturerota@gmail.com" class="text-brand-green hover:underline font-medium">
                naturerota@gmail.com
              </a>
            </p>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-8">
          <p class="text-center text-gray-600 text-sm">
            © {new Date().getFullYear()} Naturerota. Todos os direitos reservados.
          </p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>

