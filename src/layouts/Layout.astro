---
import SEO from '../components/SEO.astro';
import NavbarDemo from '../components/ui/NavbarDemo.tsx';
import SocialLink from '../components/SocialLink';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video' | 'product';
  url?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  youtubeVideoId?: string;
  videoUrl?: string;
  hideNavigation?: boolean;
  hideFooter?: boolean;
  productData?: {
    name?: string;
    description?: string;
    price?: string;
    currency?: string;
    availability?: string;
    image?: string;
  };
}

const {
  title,
  description,
  image,
  type,
  url,
  robots,
  publishedTime,
  modifiedTime,
  author,
  youtubeVideoId,
  videoUrl,
  hideNavigation = false,
  hideFooter = false,
  productData,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- CSS Crítico Inline (Above the Fold) -->
    <style is:inline>
      :root{--font-family-sans:'Poppins',system-ui,-apple-system,sans-serif;--font-family-serif:'DM Serif Display',Georgia,serif;--color-brand-green:#123A2B}body{font-family:var(--font-family-sans);margin:0;padding:0;background-color:#FFF8F2;color:#1f2937;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale}.scrolly{height:100vh;background:#FFF8F2;position:relative}.sticky{position:relative;top:auto;height:100vh;overflow:hidden}.media{position:absolute;inset:0;border-radius:0;overflow:hidden;z-index:1}.media__el{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.media__el--video{width:100vw;height:100vh;min-width:177.78vh;min-height:56.25vw;top:50%;left:50%;transform:translate(-50%,-50%);transform-origin:center}.media__el--video video{width:100%;height:100%;object-fit:cover}.overlay{position:absolute;inset:0;background:#000;opacity:.4}.copy{position:absolute;inset:0;height:100%;display:flex;align-items:center;justify-content:center;padding:0 8vw;color:#fff;z-index:5;text-align:center}.step{max-width:720px;opacity:1;transform:translateY(0);position:relative}.step h1{font-family:var(--font-family-serif);font-size:clamp(32px,4vw,56px);line-height:1.1;font-weight:700;margin:0}.container{width:100%;margin-left:auto;margin-right:auto;padding-left:1rem;padding-right:1rem}@media (min-width:640px){.container{max-width:640px}}@media (min-width:768px){.container{max-width:768px}}@media (min-width:1024px){.container{max-width:1024px}}@media (min-width:1280px){.container{max-width:1280px}}
    </style>

    <!-- Google Tag Manager - Carregar após interação do usuário -->
    <script is:inline>
      window.addEventListener('load', function() {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer','GTM-P3XJGXL5');
      });
    </script>
    <!-- End Google Tag Manager -->

    <!-- Meta Pixel Code - Carregar após interação do usuário -->
    <script is:inline>
      window.addEventListener('load', function() {
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
        n.callMethod.apply(n,arguments):n.queue.push(arguments)};
        if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
        n.queue=[];t=b.createElement(e);t.async=!0;
        t.src=v;s=b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t,s)}(window, document,'script',
        'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '1398654025074894');
        fbq('track', 'PageView');
      });
    </script>
    <!-- End Meta Pixel Code -->

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      url={url}
      robots={robots}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      youtubeVideoId={youtubeVideoId}
      videoUrl={videoUrl}
      productData={productData}
    />
    
    <!-- Preload recursos críticos para LCP (apenas na home) -->
    {Astro.url.pathname === '/' && (
      <>
        <link rel="preload" as="image" href="/avif/public/IMG_3835.avif" type="image/avif" fetchpriority="high" />
        <link rel="preload" as="image" href="/IMG_3835.JPG" type="image/jpeg" fetchpriority="high" />
        <link rel="dns-prefetch" href="https://fonts.googleapis.com" />
        <link rel="dns-prefetch" href="https://fonts.gstatic.com" />
      </>
    )}
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon_naturerota.svg" />
    <link rel="apple-touch-icon" href="/icon_naturerota.svg" />
    <link rel="mask-icon" href="/icon_naturerota.svg" color="#123A2B" />
    
    <!-- Google Fonts - Otimizado com font-display: swap e carregamento assíncrono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      media="print"
      onload="this.media='all'; this.onload=null;"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      />
    </noscript>

    <!-- Google tag (gtag.js) - Carregar após interação do usuário -->
    <script is:inline>
      window.addEventListener('load', function() {
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-9KWR7HV8NS';
        document.head.appendChild(script);
        
        script.onload = function() {
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-9KWR7HV8NS');
        };
      });
    </script>

  </head>
  <body class="min-h-screen text-gray-900 antialiased" style="background-color: #FFF8F2;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P3XJGXL5"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Meta Pixel Code (noscript) -->
    <noscript><img height="1" width="1" style="display:none"
    src="https://www.facebook.com/tr?id=1398654025074894&ev=PageView&noscript=1"
    /></noscript>
    <!-- End Meta Pixel Code (noscript) -->

    {!hideNavigation && <NavbarDemo client:idle />}

    <main style="margin-top: 0; padding-top: 0;">
      <slot />
    </main>

    {!hideFooter && (
    <footer class="border-t border-gray-200 mt-auto bg-gray-50">
      <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Navegação</h3>
            <ul class="space-y-2">
              <li>
                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
              </li>
              <li>
                <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
              </li>
              <li>
                <a href="/#sobre-nos" class="text-gray-600 hover:text-gray-900">Quem Somos</a>
              </li>
              <li>
                <a href="/#produtos" class="text-gray-600 hover:text-gray-900">Produtos</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Redes Sociais</h3>
            <ul class="space-y-2">
              <li>
                <SocialLink client:idle platform="instagram" url="https://instagram.com/naturerota" className="text-gray-600 hover:text-gray-900">
                  Instagram
                </SocialLink>
              </li>
              <li>
                <SocialLink client:idle platform="youtube" url="https://www.youtube.com/@naturerota" className="text-gray-600 hover:text-gray-900">
                  YouTube
                </SocialLink>
              </li>
              <li>
                <a href="https://www.tiktok.com/@naturerota" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  TikTok
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/profile.php?id=61573134423986" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  Facebook
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Legal</h3>
            <ul class="space-y-2">
              <li>
                <a href="/politica-de-privacidade" class="text-gray-600 hover:text-gray-900">
                  Política de Privacidade
                </a>
              </li>
              <li>
                <a href="/termos-de-uso" class="text-gray-600 hover:text-gray-900">
                  Termos de Uso
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Contato</h3>
            <p class="text-gray-600 text-sm mb-3">
              Entre em contato conosco através das nossas redes sociais ou por e-mail:
            </p>
            <p class="text-gray-700 text-sm">
              <a href="mailto:naturerota@gmail.com" class="text-brand-green hover:underline font-medium">
                naturerota@gmail.com
              </a>
            </p>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-8">
          <p class="text-center text-gray-600 text-sm">
            © {new Date().getFullYear()} Naturerota. Todos os direitos reservados.
          </p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>

