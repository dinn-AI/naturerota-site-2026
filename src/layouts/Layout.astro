---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import NavbarDemo from '../components/ui/NavbarDemo.tsx';
import SocialLink from '../components/SocialLink';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video' | 'product';
  url?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  youtubeVideoId?: string;
  videoUrl?: string;
  hideNavigation?: boolean;
  hideFooter?: boolean;
  productData?: {
    name?: string;
    description?: string;
    price?: string;
    currency?: string;
    availability?: string;
    image?: string;
  };
}

const {
  title,
  description,
  image,
  type,
  url,
  publishedTime,
  modifiedTime,
  author,
  youtubeVideoId,
  videoUrl,
  hideNavigation = false,
  hideFooter = false,
  productData,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-P3XJGXL5');</script>
    <!-- End Google Tag Manager -->

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      url={url}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      youtubeVideoId={youtubeVideoId}
      videoUrl={videoUrl}
      productData={productData}
    />
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon_naturerota.svg" />
    <link rel="apple-touch-icon" href="/icon_naturerota.svg" />
    <link rel="mask-icon" href="/icon_naturerota.svg" color="#123A2B" />
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      />
    </noscript>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-9KWR7HV8NS"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied'
      });
      gtag('js', new Date());

      gtag('config', 'G-9KWR7HV8NS');
    </script>
  </head>
  <body class="min-h-screen text-gray-900 antialiased" style="background-color: #FFF8F2;">
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-P3XJGXL5"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    {!hideNavigation && <NavbarDemo client:load />}

    <main>
      <slot />
    </main>

    <!-- Banner de consentimento de cookies -->
    <div
      id="cookie-consent-banner"
      class="fixed inset-x-0 bottom-0 z-[100002] hidden bg-white/95 backdrop-blur border-t border-gray-200"
    >
      <div class="container mx-auto px-4 py-4 flex flex-col md:flex-row items-start md:items-center gap-4 md:gap-6">
        <p class="text-sm text-gray-700 leading-relaxed">
          Usamos cookies para medir e melhorar sua experiência. Você pode aceitar para habilitar as tags de analytics e marketing.
        </p>
        <div class="flex items-center gap-3 ml-auto">
          <button id="cookie-consent-decline" class="btn-secondary text-sm px-4 py-2">
            Recusar
          </button>
          <button id="cookie-consent-accept" class="btn-primary text-sm px-4 py-2">
            Aceitar
          </button>
        </div>
      </div>
    </div>

    <script>
      (function () {
        var storageKey = "nr_cookie_consent";
        var banner = document.getElementById("cookie-consent-banner");
        var acceptBtn = document.getElementById("cookie-consent-accept");
        var declineBtn = document.getElementById("cookie-consent-decline");

        if (!banner || !acceptBtn || !declineBtn) return;

        var saved = localStorage.getItem(storageKey);
        if (!saved) {
          banner.classList.remove("hidden");
        } else if (saved === "granted") {
          window.gtag && window.gtag("consent", "update", {
            ad_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            analytics_storage: "granted"
          });
        }

        acceptBtn.addEventListener("click", function () {
          localStorage.setItem(storageKey, "granted");
          window.gtag && window.gtag("consent", "update", {
            ad_storage: "granted",
            ad_user_data: "granted",
            ad_personalization: "granted",
            analytics_storage: "granted"
          });
          banner.classList.add("hidden");
        });

        declineBtn.addEventListener("click", function () {
          localStorage.setItem(storageKey, "denied");
          window.gtag && window.gtag("consent", "update", {
            ad_storage: "denied",
            ad_user_data: "denied",
            ad_personalization: "denied",
            analytics_storage: "denied"
          });
          banner.classList.add("hidden");
        });
      })();
    </script>

    {!hideFooter && (
    <footer class="border-t border-gray-200 mt-auto bg-gray-50">
      <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Navegação</h3>
            <ul class="space-y-2">
              <li>
                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
              </li>
              <li>
                <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
              </li>
              <li>
                <a href="/#sobre-nos" class="text-gray-600 hover:text-gray-900">Quem Somos</a>
              </li>
              <li>
                <a href="/#guias" class="text-gray-600 hover:text-gray-900">Produtos</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Redes Sociais</h3>
            <ul class="space-y-2">
              <li>
                <SocialLink client:load platform="instagram" url="https://instagram.com/naturerota" className="text-gray-600 hover:text-gray-900">
                  Instagram
                </SocialLink>
              </li>
              <li>
                <SocialLink client:load platform="youtube" url="https://www.youtube.com/@naturerota" className="text-gray-600 hover:text-gray-900">
                  YouTube
                </SocialLink>
              </li>
              <li>
                <a href="https://www.tiktok.com/@naturerota" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  TikTok
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/profile.php?id=61573134423986" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  Facebook
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Legal</h3>
            <ul class="space-y-2">
              <li>
                <a href="/politica-de-privacidade" class="text-gray-600 hover:text-gray-900">
                  Política de Privacidade
                </a>
              </li>
              <li>
                <a href="/termos-de-uso" class="text-gray-600 hover:text-gray-900">
                  Termos de Uso
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Contato</h3>
            <p class="text-gray-600 text-sm mb-3">
              Entre em contato conosco através das nossas redes sociais ou por e-mail:
            </p>
            <p class="text-gray-700 text-sm">
              <a href="mailto:naturerota@gmail.com" class="text-[#123A2B] hover:underline font-medium">
                naturerota@gmail.com
              </a>
            </p>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-8">
          <p class="text-center text-gray-600 text-sm">
            © {new Date().getFullYear()} Naturerota. Todos os direitos reservados.
          </p>
        </div>
      </div>
    </footer>
    )}
  </body>
</html>

