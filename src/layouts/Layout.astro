---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import NavbarDemo from '../components/ui/NavbarDemo.tsx';
import SocialLink from '../components/SocialLink';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article' | 'video' | 'product';
  url?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  youtubeVideoId?: string;
  videoUrl?: string;
  hideNavigation?: boolean;
  hideFooter?: boolean;
  /** URL da imagem LCP (hero) para preload e melhoria de Performance (PageSpeed) */
  preloadLcpImage?: string;
  productData?: {
    name?: string;
    description?: string;
    price?: string;
    currency?: string;
    availability?: string;
    image?: string;
  };
}

const {
  title,
  description,
  image,
  type,
  url,
  robots,
  publishedTime,
  modifiedTime,
  author,
  youtubeVideoId,
  videoUrl,
  hideNavigation = false,
  hideFooter = false,
  preloadLcpImage,
  productData,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>

    <SEO
      title={title}
      description={description}
      image={image}
      type={type}
      url={url}
      robots={robots}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      youtubeVideoId={youtubeVideoId}
      videoUrl={videoUrl}
      productData={productData}
    />
    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/svg+xml" href="/icon_naturerota.svg" />
    <link rel="apple-touch-icon" href="/icon_naturerota.svg" />
    <link rel="mask-icon" href="/icon_naturerota.svg" color="#123A2B" />
    
    <!-- Preload LCP image (hero) para Performance / PageSpeed -->
    {preloadLcpImage && (
      <link rel="preload" as="image" href={preloadLcpImage} fetchpriority="high" />
    )}
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <link
      rel="preload"
      as="font"
      href="https://fonts.gstatic.com/s/dmserifdisplay/v21/jizfREFUsXFIH2BjXwM15qZHXgjV41dNgMzG.woff2"
      type="font/woff2"
      crossorigin
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;600;700&display=swap"
      />
    </noscript>
  </head>
  <body class="min-h-screen text-gray-900 antialiased" style="background-color: #FFF8F2;">

    {!hideNavigation && <NavbarDemo client:idle />}

    <main>
      <slot />
    </main>

    {!hideFooter && (
    <footer class="border-t border-gray-200 mt-auto bg-gray-50">
      <div class="container mx-auto px-4 py-12">
        <div class="grid md:grid-cols-4 gap-8 mb-8">
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Navegação</h3>
            <ul class="space-y-2">
              <li>
                <a href="/" class="text-gray-600 hover:text-gray-900">Home</a>
              </li>
              <li>
                <a href="/blog" class="text-gray-600 hover:text-gray-900">Blog</a>
              </li>
              <li>
                <a href="/#sobre-nos" class="text-gray-600 hover:text-gray-900">Quem Somos</a>
              </li>
              <li>
                <a href="/#produtos" class="text-gray-600 hover:text-gray-900">Produtos</a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Redes Sociais</h3>
            <ul class="space-y-2">
              <li>
                <SocialLink client:visible platform="instagram" url="https://instagram.com/naturerota" className="text-gray-600 hover:text-gray-900">
                  Instagram
                </SocialLink>
              </li>
              <li>
                <SocialLink client:visible platform="youtube" url="https://www.youtube.com/@naturerota" className="text-gray-600 hover:text-gray-900">
                  YouTube
                </SocialLink>
              </li>
              <li>
                <a href="https://www.tiktok.com/@naturerota" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  TikTok
                </a>
              </li>
              <li>
                <a href="https://www.facebook.com/profile.php?id=61573134423986" target="_blank" rel="noopener noreferrer" class="text-gray-600 hover:text-gray-900">
                  Facebook
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Legal</h3>
            <ul class="space-y-2">
              <li>
                <a href="/politica-de-privacidade" class="text-gray-600 hover:text-gray-900">
                  Política de Privacidade
                </a>
              </li>
              <li>
                <a href="/termos-de-uso" class="text-gray-600 hover:text-gray-900">
                  Termos de Uso
                </a>
              </li>
            </ul>
          </div>
          <div>
            <h3 class="font-bold font-sans text-gray-900 mb-4">Contato</h3>
            <p class="text-gray-600 text-sm mb-3">
              Entre em contato conosco através das nossas redes sociais ou por e-mail:
            </p>
            <p class="text-gray-700 text-sm">
              <a href="mailto:naturerota@gmail.com" class="text-brand-green hover:underline font-medium">
                naturerota@gmail.com
              </a>
            </p>
          </div>
        </div>
        <div class="border-t border-gray-200 pt-8">
          <p class="text-center text-gray-600 text-sm">
            © {new Date().getFullYear()} Naturerota. Todos os direitos reservados.
          </p>
        </div>
      </div>
    </footer>
    )}

    <!-- Script para capturar UTMs e repassar para checkout Hotmart (adiado para não competir com LCP) -->
    <script is:inline>
      (function() {
        function applyHotmartUtms() {
          var parameters = ['src', 'utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
          var urlParams = new URLSearchParams(window.location.search);
          var paramsToAdd = {};
          parameters.forEach(function(param) {
            if (urlParams.has(param)) paramsToAdd[param] = urlParams.get(param);
          });
          if (Object.keys(paramsToAdd).length === 0) return;
          document.querySelectorAll('a[href*="hotmart.com"]').forEach(function(link) {
            try {
              var url = new URL(link.href);
              Object.keys(paramsToAdd).forEach(function(key) { url.searchParams.set(key, paramsToAdd[key]); });
              link.href = url.toString();
            } catch (e) {}
          });
        }
        if (window.requestIdleCallback) {
          requestIdleCallback(applyHotmartUtms, { timeout: 3000 });
        } else {
          window.addEventListener('load', function() { setTimeout(applyHotmartUtms, 1); });
        }
      })();
    </script>

    <!-- ========================================
         OPTIMIZED THIRD-PARTY SCRIPTS LAZY LOADING
         ======================================== -->
    <script is:inline>
      /**
       * STRATEGY FOR CORE WEB VITALS OPTIMIZATION:
       * 
       * Problem: Third-party scripts (GTM, GA4, Meta Pixel, TikTok) block rendering
       * and increase INP/TBT by consuming main thread early.
       * 
       * Solution: Lazy-load scripts strategically to avoid blocking:
       * 
       * 1. GTM, GA4, TikTok: Load after window.load (or requestIdleCallback)
       *    - These are analytics, not critical for user experience
       *    - Deferred loading reduces impact on LCP and FCP
       * 
       * 2. Meta Pixel: Load on first user interaction (pointerdown/scroll)
       *    - Lower priority than analytics
       *    - Only loads if user is actually engaged
       *    - Fallback: loads after 5 seconds if no interaction
       * 
       * 3. All scripts use async loading to prevent blocking
       * 
       * Result: Improved LCP, FCP, INP, TBT metrics
       */

      window._thirdPartyLoaded = false;
      window._metaPixelLoaded = false;

      function loadAnalytics() {
        if (window._thirdPartyLoaded) return;
        window._thirdPartyLoaded = true;

        // ===== GTM (Google Tag Manager) =====
        (function(w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0],
            j = d.createElement(s),
            dl = l != 'dataLayer' ? '&l=' + l : '';
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
          d.body.appendChild(j);
        })(window, document, 'script', 'dataLayer', 'GTM-P3XJGXL5');

        // ===== GA4 (Google Analytics 4) =====
        var gaScript = document.createElement('script');
        gaScript.async = true;
        gaScript.src = 'https://www.googletagmanager.com/gtag/js?id=G-9KWR7HV8NS';
        document.body.appendChild(gaScript);

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', 'G-9KWR7HV8NS', { 'anonymize_ip': true });

        // ===== TikTok Pixel =====
        (function(w, d, t) {
          w.TiktokAnalyticsObject = t;
          var ttq = w[t] = w[t] || [];
          ttq.methods = ["page", "track", "identify", "instances", "debug", "on", "off", "once", "ready", "alias", "group", "enableCookie", "disableCookie", "holdConsent", "revokeConsent", "grantConsent"];
          ttq.setAndDefer = function(t, e) {
            t[e] = function() {
              t.push([e].concat(Array.prototype.slice.call(arguments, 0)));
            };
          };
          for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
          ttq.instance = function(t) {
            for (var e = ttq._i[t] || [], n = 0; n < ttq.methods.length; n++) ttq.setAndDefer(e, ttq.methods[n]);
            return e;
          };
          ttq.load = function(e, n) {
            var r = "https://analytics.tiktok.com/i18n/pixel/events.js", o = n && n.partner;
            ttq._i = ttq._i || {};
            ttq._i[e] = [];
            ttq._i[e]._u = r;
            ttq._t = ttq._t || {};
            ttq._t[e] = +new Date();
            ttq._o = ttq._o || {};
            ttq._o[e] = n || {};
            n = document.createElement("script");
            n.type = "text/javascript";
            n.async = !0;
            n.src = r + "?sdkid=" + e + "&lib=" + t;
            e = document.getElementsByTagName("script")[0];
            e.parentNode.insertBefore(n, e);
          };
          ttq.load('D6BL7NBC77UBQKG7PF20');
          ttq.page();
        })(window, document, 'ttq');
      }

      function loadMetaPixel() {
        if (window._metaPixelLoaded) return;
        window._metaPixelLoaded = true;

        document.removeEventListener('pointerdown', loadMetaPixel, true);
        document.removeEventListener('scroll', loadMetaPixel, true);

        // ===== Meta Pixel (Facebook Events) =====
        !function(f, b, e, v, n, t, s) {
          if (f.fbq) return;
          n = f.fbq = function() {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          };
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = !0;
          n.version = '2.0';
          n.queue = [];
          t = b.createElement(e);
          t.async = !0;
          t.src = v;
          s = b.getElementsByTagName(e)[0];
          s.parentNode.insertBefore(t, s);
        }(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

        fbq('init', '1398654025074894', {
          em: window.localStorage.getItem('user_email') || '', // Tenta capturar e-mail do localStorage se disponível
          ph: window.localStorage.getItem('user_phone') || ''  // Tenta capturar telefone do localStorage se disponível
        });
        fbq('track', 'PageView');
      }

      // ===== EXECUTION STRATEGY =====
      
      // Load GTM, GA4, TikTok after page load
      if (document.readyState === 'loading') {
        window.addEventListener('load', loadAnalytics);
      } else {
        // DOM already loaded
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadAnalytics, { timeout: 3000 });
        } else {
          setTimeout(loadAnalytics, 1000);
        }
      }

      // Load Meta Pixel on first user interaction
      document.addEventListener('pointerdown', loadMetaPixel, { once: true, capture: true });
      document.addEventListener('scroll', loadMetaPixel, { once: true, capture: true });

      // Fallback: load Meta Pixel after 5 seconds if no interaction
      setTimeout(() => {
        if (!window._metaPixelLoaded) {
          loadMetaPixel();
        }
      }, 5000);
    </script>
  </body>
</html>
