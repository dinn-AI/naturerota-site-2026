---
import VideoPlayer from "./VideoPlayer";

const videoSrc = "/videos/Trailer_Naturerota.mp4";
// Usar uma imagem existente como poster (pode ser substituída depois)
const videoPoster = "/avif/public/IMG_3835.avif";
const videoPosterFallback = "/IMG_3835.JPG";
---

<section class="scrolly" id="scrolly-hero">
  <div class="sticky">
    <div class="media" id="media">
      <VideoPlayer
        client:load
        src={videoSrc}
        poster={videoPoster}
        autoplay={true}
        loop={true}
        muted={true}
        controls={false}
        playsInline={true}
        preload="metadata"
        className="media__el media__el--video"
      />
      <div class="overlay" aria-hidden="true"></div>
    </div>

    <div class="copy" aria-hidden="false">
      <div class="step" data-step="0">
        <h1>Inspiramos você a viajar mais e transformar a vida em uma grande aventura</h1>
        <div class="mt-6 flex justify-center">
          <a
            href="https://www.youtube.com/@naturerota"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 md:gap-3 text-white border-2 border-white px-5 md:px-8 py-2.5 md:py-3.5 rounded-full font-sans font-bold text-sm md:text-lg uppercase tracking-wide transition-all duration-300 ease-in-out hover:bg-white/25"
          >
            Acessar Canal YouTube
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script type="module">
  const reduceMotion = window.matchMedia?.("(prefers-reduced-motion: reduce)")?.matches;
  if (reduceMotion) {
    const step = document.querySelector("#scrolly-hero .step");
    const overlay = document.querySelector("#scrolly-hero .overlay");
    if (step) step.style.opacity = "1";
    if (overlay) overlay.style.opacity = "0.4";
  } else {
    // Scroll effect removido: sem pin e sem animação.
  }
</script>

<style>
  .scrolly {
    height: 100vh;
    background: #FFF8F2;
    position: relative;
    margin-top: 0;
    padding-top: 0;
  }

  .sticky {
    position: relative;
    top: auto;
    height: 100vh;
    overflow: hidden;
  }

  .media {
    position: absolute;
    inset: 0;
    border-radius: 0;
    overflow: hidden;
    z-index: 1;
    clip-path: inset(0% 0% 0% 0% round 0px);
    will-change: clip-path;
  }

  .media__el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .media__el--video {
    width: 100vw;
    height: 100vh;
    min-width: 177.78vh;
    min-height: 56.25vw;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transform-origin: center;
  }

  .media__el--video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .overlay {
    position: absolute;
    inset: 0;
    background: #000;
    opacity: 0.4;
    transition: none;
  }

  .copy {
    position: absolute;
    inset: 0;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 8vw;
    color: #fff;
    z-index: 5;
    text-align: center;
  }

  .step {
    max-width: 720px;
    opacity: 1;
    transform: translateY(0);
    position: relative;
  }

  .step h1 {
    font-family: "DM Serif Display", serif;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.1;
    font-weight: 700;
    margin: 0;
  }
</style>
