---
import ProductsCarouselDemo from "./products-carousel-demo";
---

<section id="produtos" class="py-16" style="background-color: #FFF8F2;">
  <div class="px-4">
    <div class="max-w-7xl mx-auto text-center mb-10">
      <h2 class="heading-primary mb-4">
        Nossos produtos
      </h2>
      <p class="text-lg text-gray-700 leading-relaxed max-w-4xl mx-auto">
        Ao adquirir nossos produtos, você ajuda a manter o projeto da <strong>Kombi Catarina</strong> no ar e nos permite continuar produzindo conteúdo gratuito no YouTube.
      </p>
    </div>
  </div>

  <!-- Carrossel em largura total -->
  <div class="w-full">
    <ProductsCarouselDemo client:load />
  </div>
</section>

