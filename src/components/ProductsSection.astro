---
import ProductsCarousel from './ProductsCarousel';
---

<section id="produtos" class="py-16 md:py-24">
  <div class="container mx-auto px-4">
    <!-- Título -->
    <div class="max-w-4xl mx-auto text-center mb-6">
      <h2 class="heading-primary mb-4">Nossos Produtos</h2>
    </div>

    <!-- Descrição -->
    <div class="max-w-3xl mx-auto text-center mb-12">
      <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
        Ao comprar um de nossos produtos, você colabora para o nosso projeto de continuar explorando o mundo e compartilha tudo gratuitamente aqui na internet e no YouTube!
      </p>
    </div>

  </div>
  
  <!-- Carrossel de Produtos - Full Width -->
  <div class="w-full">
    <ProductsCarousel client:load products={[
        {
          id: 'patagonia',
          image: '/products_cover/20_dias_pela_patagonia_de_CARRO.svg',
          alt: 'Guia da Patagônia de Carro - 20 dias até Ushuaia',
          href: '/20-dias-pela-patagonia'
        },
        {
          id: 'bonito',
          image: '/products_cover/Roteiro_de_4_dias_em_Bonito_MS_Brasil.svg',
          alt: 'Roteiro de 4 dias em Bonito MS - Viagem de carro em casal',
          href: '/4-dias-em-bonito-ms'
        },
        {
          id: 'pets',
          image: '/products_cover/Vida_na_Estrada_com_Pets.svg',
          alt: 'Vida na Estrada com Pets - Guia completo para viajar com animais',
          href: '/4-patas-na-estrada'
        },
        {
          id: 'espirito-santo',
          image: '/products_cover/Praias para conhecer no Espírito Santo de Motorhome.svg',
          alt: 'Praias para conhecer no Espírito Santo de Motorhome',
          href: '/guia-litoral-es'
        }
    ]} />
  </div>
</section>
