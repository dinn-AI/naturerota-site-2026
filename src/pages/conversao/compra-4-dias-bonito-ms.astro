---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Compra confirmada | Naturerota"
  description="Obrigado pela compra. Estamos registrando sua conversão e em instantes você pode voltar ao site."
  type="website"
  robots="noindex, nofollow"
  hideNavigation={true}
  hideFooter={true}
>
  <section class="py-16 md:py-24" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-3xl md:text-5xl font-serif font-semibold text-gray-900 leading-tight">
          Compra confirmada!
        </h1>
        <p class="mt-6 text-lg md:text-xl text-gray-700 leading-relaxed">
          Obrigado por comprar o nosso roteiro. Se você ainda não recebeu o acesso, verifique seu e-mail (incluindo spam e promoções).
        </p>
        <div class="mt-10">
          <a href="/" class="btn-primary inline-flex items-center justify-center text-center">
            Voltar para o site
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Event snippet for Compra E-boom 4 dias Bonito MS conversion page -->
  <script is:inline>
    (function () {
      var sendTo = "AW-17507970089/gd2SCKeeue4bEKnYuZxB";
      var value = 1.0;
      var currency = "BRL";

      var params = new URLSearchParams(window.location.search);
      var transactionId = params.get("transaction_id") || params.get("tid") || "";
      var buyerEmail = params.get('buyer_email') || params.get('email') || '';
      var buyerPhone = params.get('buyer_phone') || params.get('phone') || '';
      var buyerName  = params.get('buyer_name')  || params.get('name')  || '';
      var purchaseValue = parseFloat(params.get('value') || '47.00');

      // Persiste dados do comprador no localStorage
      if (buyerEmail) window.localStorage.setItem('user_email', buyerEmail.toLowerCase().trim());
      if (buyerPhone) window.localStorage.setItem('user_phone', buyerPhone.replace(/\D/g, ''));

      // Evita duplicar conversão em refresh (por sessão)
      var storageKey = "nr_conv_sent_" + (transactionId || "no_tid");
      try {
        if (sessionStorage.getItem(storageKey)) return;
        sessionStorage.setItem(storageKey, "1");
      } catch (e) {}

      // ===== Google Ads conversion =====
      if (typeof window.gtag === "function") {
        window.gtag("event", "conversion", {
          send_to: sendTo,
          value: value,
          currency: currency,
          transaction_id: transactionId,
        });
      }

      // ===== Meta Pixel Purchase =====
      function firePurchase() {
        if (typeof window.fbq !== 'function') return;
        var matchData = {};
        var em = window.localStorage.getItem('user_email');
        var ph = window.localStorage.getItem('user_phone');
        if (em) matchData.em = em;
        if (ph) matchData.ph = ph;
        if (buyerName) {
          var parts = buyerName.trim().split(' ');
          if (parts[0]) matchData.fn = parts[0];
          if (parts.length > 1) matchData.ln = parts[parts.length - 1];
        }

        var event_id = 'purchase_bonito_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);
        window.fbq('init', '1398654025074894', matchData);
        window.fbq('track', 'Purchase', {
          value: purchaseValue,
          currency: 'BRL',
          event_id: event_id
        });

        // CAPI server-side
        var capiUserData = { client_user_agent: navigator.userAgent };
        if (matchData.em) capiUserData.em = matchData.em;
        if (matchData.ph) capiUserData.ph = matchData.ph;
        fetch('/api/fbevents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            event_name: 'Purchase',
            event_id: event_id,
            event_source_url: window.location.href,
            custom_data: { value: purchaseValue, currency: 'BRL' },
            user_data: capiUserData
          })
        }).catch(function(err) { console.error('Erro CAPI:', err); });
      }

      // Aguarda pixel carregar (lazy load do Layout)
      var attempts = 0;
      var checkPixel = setInterval(function() {
        attempts++;
        if (typeof window.fbq === 'function' || attempts > 60) {
          clearInterval(checkPixel);
          if (typeof window.fbq === 'function') firePurchase();
        }
      }, 500);
    })();
  </script>
</Layout>

