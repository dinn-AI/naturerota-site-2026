---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Seja bem-vindo(a)! | Naturerota"
  description="Obrigado por fazer parte da família Naturerota. Agora é só entrar no grupo e embarcar nessa jornada com a gente."
  type="website"
>
  <!-- Hero: título + foto em destaque -->
  <section class="py-16 md:py-24 text-center" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <p class="text-sm font-sans text-gray-500 uppercase tracking-widest mb-3">
          Bem-vindo(a) à família!
        </p>
        <h1 class="text-3xl md:text-5xl font-serif font-semibold text-gray-900 leading-tight">
          Obrigado por embarcar com a gente! 🚐✨
        </h1>
        <p class="mt-5 text-lg md:text-xl text-gray-700 leading-relaxed">
          Aqui é o <strong>Renan e a Millena</strong>. Ficamos muito felizes em ter você como aluno(a)!
          Preparamos tudo com muito carinho para que essa jornada seja transformadora.
        </p>

        <!-- Botão WhatsApp (topo) -->
        <div class="mt-8">
          <a
            href="https://chat.whatsapp.com/FqZMs1ib1S0ETVZT7UkhRO?mode=gi_t"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center gap-2 text-center"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
            Entrar no grupo de alunos
          </a>
        </div>

        <!-- Foto em destaque -->
        <div class="mt-10 rounded-2xl overflow-hidden shadow-lg max-w-2xl mx-auto">
          <img
            src="/avif/public/IMG_3837.avif"
            alt="Renan e Millena — Naturerota"
            width="800"
            height="600"
            loading="eager"
            decoding="async"
            class="w-full h-auto object-cover"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Próximo passo: WhatsApp -->
  <section class="py-14 md:py-20 bg-white text-center">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto">
        <h2 class="text-2xl md:text-3xl font-serif font-semibold text-gray-900 mb-4">
          Agora é só entrar no grupo exclusivo 👇
        </h2>
        <p class="text-lg text-gray-700 leading-relaxed mb-8">
          Toda a comunidade de alunos está reunida lá. Tire dúvidas, troque experiências
          e acompanhe as novidades em primeira mão.
        </p>
        <a
          href="https://chat.whatsapp.com/FqZMs1ib1S0ETVZT7UkhRO?mode=gi_t"
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center justify-center gap-2 text-center"
        >
          <!-- WhatsApp icon -->
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Entrar no grupo de alunos
        </a>

        <p class="mt-10 text-base text-gray-500">
          Um abraço carinhoso,<br />
          <strong>Renan e Millena | Naturerota</strong>
        </p>
      </div>
    </div>
  </section>

  <!-- Google tag event - Purchase Conversion -->
  <script is:inline>
    if (typeof window.gtag === 'function') {
      gtag('event', 'purchase', {});
    }
  </script>
</Layout>
