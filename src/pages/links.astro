---
// /links — Página de acesso rápido (Naturerota)
// Página ultra-leve: sem layout global, sem scripts, inline CSS
---

<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Links rápidos da Naturerota — YouTube, cursos, ebooks e site oficial." />
  <title>Links | Naturerota</title>

  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html, body {
      height: 100%;
      background-color: #123A2B;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    .page {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      overflow: hidden;
    }

    /* -------- Imagem de fundo -------- */
    .bg-img {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: auto;       /* largura natural, não estica */
      height: 100%;      /* escala 100% da altura do container */
      min-height: 100vh; /* nunca menor que a viewport */
      pointer-events: none;
      z-index: 0;
      display: block;
    }

    /* -------- Conteúdo principal -------- */
    .content {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 480px;
      padding: 0 20px 80px;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* -------- Logo -------- */
    .logo-wrap {
      margin-top: 52px;
      margin-bottom: 40px;
      display: flex;
      justify-content: center;
    }

    .logo-wrap img {
      width: 160px;
      height: auto;
      display: block;
      /* Logo paths are dark green (#123A2B) — invert to white on dark bg */
      filter: brightness(0) invert(1);
    }

    /* -------- Botões -------- */
    .links-list {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: 14px;
      list-style: none;
    }

    .links-list a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 18px 24px;
      background-color: #F5ECD9;
      border-radius: 50px;
      color: #2B2B2B;
      font-size: 1rem;
      font-weight: 500;
      letter-spacing: 0.01em;
      text-decoration: none;
      text-align: center;
      line-height: 1.3;
      transition: background-color 0.18s ease, transform 0.12s ease;
      -webkit-tap-highlight-color: transparent;
      cursor: pointer;
    }

    .links-list a:hover,
    .links-list a:focus-visible {
      background-color: #ede3d0;
      transform: scale(1.015);
      outline: none;
    }

    .links-list a:active {
      transform: scale(0.985);
    }

    /* -------- Responsivo desktop -------- */
    @media (min-width: 560px) {
      .logo-wrap {
        margin-top: 64px;
        margin-bottom: 48px;
      }
      .logo-wrap img { width: 180px; }
      .links-list a { font-size: 1.05rem; }
    }
  </style>
</head>
<body>
  <div class="page">

    <!-- Imagem de fundo -->
    <img
      class="bg-img"
      src="/Bg-elementos.png"
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />

    <!-- Conteúdo centralizado acima do BG -->
    <main class="content">
      <!-- Logo -->
      <div class="logo-wrap">
        <img
          src="/Logotipo_naturerota.svg"
          alt="Naturerota"
          width="160"
          height="80"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- Lista de links -->
      <ul class="links-list">
        <li>
          <a
            href="https://www.youtube.com/@naturerota"
            target="_blank"
            rel="noopener noreferrer"
          >
            Nosso canal no YouTube
          </a>
        </li>
        <li>
          <a href="/cgdv">
            Curso: como ganhar dinheiro viajando
          </a>
        </li>
        <li>
          <a href="/20-dias-pela-patagonia">
            Ebook: 20 dias pela patagônia de carro
          </a>
        </li>
        <li>
          <a
            href="https://collshp.com/renanecavalheiro716?view=storefront&fbclid=PAZXh0bgNhZW0CMTEAc3J0YwZhcHBfaWQPMTI0MDI0NTc0Mjg3NDE0AAGnzScukXC9vGFUHCKN8BmtAk-A6vev3pp0-ML4VZSAeslI4Hh-1jKjuCu4L6A_aem_WSrB0mF5mC0RSEIvw-2XlA"
            target="_blank"
            rel="noopener noreferrer"
          >
            Produtos na Shopee
          </a>
        </li>
        <li>
          <a
            href="https://meli.la/1DswwAv"
            target="_blank"
            rel="noopener noreferrer"
          >
            Produtos no Mercado Livre
          </a>
        </li>
        <li>
          <a href="/">
            Nosso site oficial
          </a>
        </li>
      </ul>
    </main>

  </div>
</body>
</html>
