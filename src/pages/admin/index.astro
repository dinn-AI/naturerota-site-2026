---
// Página limpa sem layout - apenas para o Sanity Studio
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex" />
  <title>Admin - Naturerota</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    #sanity-root {
      width: 100%;
      height: 100%;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
    }
    iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }
  </style>
</head>
<body>
  <div id="sanity-root"></div>

  <script>
    // Detecta se está em desenvolvimento ou produção
    const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const container = document.getElementById('sanity-root');
    
    if (isDev) {
      // Em desenvolvimento, carrega o Studio local via iframe
      const iframe = document.createElement('iframe');
      iframe.src = 'http://localhost:3333';
      iframe.style.width = '100%';
      iframe.style.height = '100vh';
      iframe.style.border = 'none';
      container.appendChild(iframe);
    } else {
      // Em produção, carrega o Studio deployado diretamente
      const studioUrl = 'https://naturerota-blog.sanity.studio';
      
      // Mostra loading enquanto carrega
      container.innerHTML = `
        <div id="loading" style="
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          height: 100vh;
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
          background: #123A2B;
          color: white;
        ">
          <div style="
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.2);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
          "></div>
          <p style="margin-top: 20px;">Carregando Sanity Studio...</p>
        </div>
        <style>
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
        </style>
      `;
      
      // Carrega o iframe
      const iframe = document.createElement('iframe');
      iframe.src = studioUrl;
      iframe.style.width = '100%';
      iframe.style.height = '100vh';
      iframe.style.border = 'none';
      iframe.style.display = 'none'; // Esconde até carregar
      
      // Quando o iframe carregar, remove o loading
      iframe.onload = function() {
        const loading = document.getElementById('loading');
        if (loading) loading.remove();
        iframe.style.display = 'block';
      };
      
      // Se houver erro, mostra mensagem
      iframe.onerror = function() {
        container.innerHTML = `
          <div style="
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            height: 100vh;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background: #123A2B;
            color: white;
            padding: 20px;
            text-align: center;
          ">
            <h1 style="margin-bottom: 20px;">⚠️ Erro ao Carregar Studio</h1>
            <p style="max-width: 600px; margin-bottom: 30px; line-height: 1.6;">
              Não foi possível carregar o Sanity Studio.<br>
              Acesse diretamente:
            </p>
            <a href="${studioUrl}" target="_blank" style="
              background: #A4D0AF;
              color: #123A2B;
              padding: 12px 24px;
              border-radius: 8px;
              text-decoration: none;
              font-weight: 600;
              margin: 20px 0;
            ">
              Abrir Studio em Nova Aba
            </a>
            <p style="margin-top: 20px;">
              <a href="/" style="color: #A4D0AF; text-decoration: underline;">← Voltar para o site</a>
            </p>
          </div>
        `;
      };
      
      container.appendChild(iframe);
    }
  </script>
</body>
</html>
