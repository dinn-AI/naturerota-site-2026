---
// Página limpa sem layout - apenas para o Sanity Studio
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="robots" content="noindex" />
  <title>Admin - Naturerota</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html, body {
      width: 100%;
      height: 100%;
      overflow: hidden;
    }
    #sanity-root {
      width: 100%;
      height: 100%;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 9999;
    }
    iframe {
      width: 100%;
      height: 100%;
      border: none;
      display: block;
    }
  </style>
</head>
<body>
  <div id="sanity-root"></div>

  <script>
    // Detecta se está em desenvolvimento ou produção
    const isDev = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
    const container = document.getElementById('sanity-root');
    
    if (isDev) {
      // Em desenvolvimento, carrega o Studio local via iframe
      const iframe = document.createElement('iframe');
      iframe.src = 'http://localhost:3333';
      iframe.style.width = '100%';
      iframe.style.height = '100vh';
      iframe.style.border = 'none';
      container.appendChild(iframe);
    } else {
      // Em produção, tenta carregar o Studio deployado
      const studioUrl = 'https://naturerota.sanity.studio';
      
      // Primeiro, mostra loading
      container.innerHTML = `
        <div style="
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          height: 100vh;
          font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
          background: #123A2B;
          color: white;
        ">
          <div style="
            width: 50px;
            height: 50px;
            border: 4px solid rgba(255,255,255,0.2);
            border-top-color: white;
            border-radius: 50%;
            animation: spin 1s linear infinite;
          "></div>
          <p style="margin-top: 20px;">Carregando Studio...</p>
        </div>
        <style>
          @keyframes spin {
            to { transform: rotate(360deg); }
          }
        </style>
      `;
      
      // Tenta carregar o Studio
      fetch(studioUrl, { method: 'HEAD' })
        .then(() => {
          // Studio existe, carrega via iframe
          container.innerHTML = '';
          const iframe = document.createElement('iframe');
          iframe.src = studioUrl;
          iframe.style.width = '100%';
          iframe.style.height = '100vh';
          iframe.style.border = 'none';
          container.appendChild(iframe);
        })
        .catch(() => {
          // Studio não existe ainda, mostra instruções
          container.innerHTML = `
            <div style="
              display: flex;
              flex-direction: column;
              align-items: center;
              justify-content: center;
              height: 100vh;
              font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
              background: #123A2B;
              color: white;
              padding: 20px;
              text-align: center;
            ">
              <h1 style="margin-bottom: 20px;">🔧 Deploy Necessário</h1>
              <p style="max-width: 600px; margin-bottom: 30px; line-height: 1.6;">
                O Sanity Studio ainda não foi deployado para produção.<br>
                Para gerenciar conteúdo em produção, execute no seu computador:
              </p>
              <div style="background: rgba(255,255,255,0.1); padding: 20px; border-radius: 8px; max-width: 700px;">
                <code style="display: block; background: rgba(0,0,0,0.3); padding: 15px; border-radius: 4px; margin: 10px 0; text-align: left; font-size: 14px;">
                  bash deploy-studio-prod.sh
                </code>
              </div>
              <p style="margin-top: 30px; color: #A4D0AF;">
                Ou acesse temporariamente:<br>
                <a href="https://www.sanity.io/manage" target="_blank" style="color: #A4D0AF; text-decoration: underline;">
                  Sanity Dashboard
                </a>
              </p>
              <p style="margin-top: 20px;">
                <a href="/" style="color: #A4D0AF; text-decoration: underline;">← Voltar para o site</a>
              </p>
            </div>
          `;
        });
    }
  </script>
</body>
</html>
