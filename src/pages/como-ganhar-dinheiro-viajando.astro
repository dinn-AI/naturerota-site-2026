---
import Layout from "../layouts/Layout.astro";


const checkoutUrl = "https://pay.hotmart.com/K105077150A?checkoutMode=10&bid=1774553429551";
---

<Layout
  title="Como Ganhar Dinheiro Viajando | Método CGDV | Naturerota"
  description="Aprenda a viver na estrada com segurança financeira. O Método CGDV é um passo a passo prático para sair da vida tradicional, organizar seu dinheiro e criar renda na estrada — mesmo começando do zero."
  type="product"
  hideNavigation={true}
  hideFooter={true}
  preloadLcpImage="/curso-cgdv/IMG_6289.avif"
>
  <!-- Hero -->
  <section class="relative overflow-visible" style="background-color: #123A2B;">
    <div class="relative container mx-auto px-4 py-16 md:py-20 lg:py-24">
      <!-- Layout responsivo: empilhado em mobile, 2 colunas em desktop -->
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        
        <!-- Coluna da esquerda: Texto e CTA -->
        <div class="text-left order-1 lg:order-1">
          <h1 class="text-white font-serif font-semibold text-3xl md:text-4xl lg:text-5xl leading-tight">
            Viva na estrada com segurança financeira
          </h1>
          <p class="mt-6 text-white/90 text-lg md:text-xl leading-relaxed">
            Mesmo começando do zero e sem depender da internet
          </p>

          <div class="mt-8 lg:mt-10 mb-8 lg:mb-0">
            <a
              href={checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center justify-center text-center w-full sm:w-auto"
              style="background-color: #87A48E; border-color: #87A48E;"
            >
              COMEÇAR AGORA
            </a>
          </div>
        </div>

        <!-- Coluna da direita: Foto hero -->
        <div class="flex justify-center lg:justify-end order-2 lg:order-2">
          <img
            src="/curso-cgdv/IMG_6289.avif"
            alt="Viver na estrada com segurança financeira — Método CGDV"
            class="w-full max-w-sm md:max-w-md lg:max-w-lg xl:max-w-xl h-auto drop-shadow-2xl rounded-2xl object-cover"
            style="max-height: 480px;"
            width="480"
            height="480"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Seção Identificação -->
  <section class="pt-16 pb-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Números de Credibilidade -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-serif font-semibold" style="color:#123A2B;">+8</p>
            <p class="text-gray-600 mt-2 text-sm md:text-base">Meses na estrada</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-serif font-semibold" style="color:#123A2B;">+20k</p>
            <p class="text-gray-600 mt-2 text-sm md:text-base">Km rodados</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-serif font-semibold" style="color:#123A2B;">+300</p>
            <p class="text-gray-600 mt-2 text-sm md:text-base">Ideias de renda</p>
          </div>
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-serif font-semibold" style="color:#123A2B;">7 dias</p>
            <p class="text-gray-600 mt-2 text-sm md:text-base">Garantia total</p>
          </div>
        </div>

        <!-- Grid de fotos da jornada -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_6080.avif"
              alt="Vida na estrada"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_0515.avif"
              alt="Viajando pelo Brasil"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_8890.avif"
              alt="Liberdade na estrada"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_9073.avif"
              alt="Renda viajando"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <!-- Mensagem de credibilidade -->
        <div class="mt-10 text-center max-w-3xl mx-auto">
          <p class="text-lg md:text-xl text-gray-700 leading-relaxed">
            <strong>Experiência real, método real.</strong> Mais de 8 meses na estrada e 20.000 km rodados — erros reais que viraram método para você replicar com segurança.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção VSL: Vídeo -->
  <section class="py-16" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <div class="bg-white rounded-2xl shadow-lg p-6 md:p-8">
          <h2 class="text-2xl md:text-3xl font-serif font-semibold mb-4 text-center" style="color:#123A2B;">
            Assista ao vídeo antes de tomar qualquer decisão
          </h2>
          <p class="text-center text-gray-600 mb-6">Você vai entender:</p>
          <ul class="space-y-2 mb-6 max-w-xl mx-auto text-gray-700">
            <li class="flex items-start gap-2"><span class="text-green-700 font-bold mt-0.5">•</span> Por que a maioria falha tentando viver viajando</li>
            <li class="flex items-start gap-2"><span class="text-green-700 font-bold mt-0.5">•</span> Como gerar renda na estrada (sem depender de redes sociais)</li>
            <li class="flex items-start gap-2"><span class="text-green-700 font-bold mt-0.5">•</span> O erro que faz iniciantes perderem dinheiro</li>
            <li class="flex items-start gap-2"><span class="text-green-700 font-bold mt-0.5">•</span> O caminho simples para começar com segurança</li>
          </ul>
          <div class="mt-6">
            <video
            src="/videos/Trailer_Naturerota.mp4"
            controls
            preload="metadata"
            class="w-full rounded-xl"
            style="max-height: 480px;"
          >
            Seu navegador não suporta vídeo HTML5.
          </video>
          </div>
          <p class="mt-6 text-center text-gray-600 text-base leading-relaxed">
            Sem promessas irreais. Sem "largar tudo" no impulso.<br>
            <strong>Existe um caminho mais seguro — e é isso que você vai ver agora.</strong>
          </p>
          <div class="mt-6 text-center">
            <a
              href={checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center justify-center text-center"
            >
              COMEÇAR AGORA
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção Identificação: Você se encaixa aqui? -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          <div>
            <h2 class="heading-primary mb-6">
              Se você sente que…
            </h2>
            <ul class="space-y-4 text-lg text-gray-700">
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Está preso em uma rotina que não faz sentido</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Trabalha muito, mas não vive</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Quer viajar, mas o dinheiro trava</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span>Tem medo de dar errado</span>
              </li>
            </ul>
            <div class="mt-8 p-6 rounded-2xl" style="background-color: #123A2B;">
              <p class="text-white text-xl font-semibold">O problema não é você.</p>
              <p class="text-white/90 mt-2">É não ter um plano.</p>
            </div>
          </div>

          <div class="lg:sticky lg:top-24">
            <img
              src="/curso-cgdv/IMG_9198.avif"
              alt="Vivendo na estrada com liberdade"
              class="w-full max-w-md lg:max-w-none mx-auto rounded-2xl shadow-lg object-cover"
              width="480"
              height="320"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção Virada -->
  <section class="py-16" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="heading-primary mb-6 text-center">A verdade que ninguém te conta</h2>
        <p class="text-center text-gray-600 mb-10 max-w-3xl mx-auto text-lg">
          A maioria acha que viver na estrada é sobre coragem. Mas não é.
        </p>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="bg-white rounded-2xl shadow-sm p-6">
            <img
              src="/curso-cgdv/IMG_0523.avif"
              alt="Planejamento para vida na estrada"
              class="w-full h-40 object-cover rounded-xl mb-5"
              width="400"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <h3 class="font-sans font-semibold text-gray-900 mb-3">Planejamento</h3>
            <p class="text-gray-700 leading-relaxed">
              Não é sobre coragem e nem sobre arriscar tudo ou nada. É sobre sabi como planejar cada passo antes de dar.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow-sm p-6">
            <img
              src="/curso-cgdv/IMG_5639.avif"
              alt="Segurança financeira na estrada"
              class="w-full h-40 object-cover rounded-xl mb-5"
              width="400"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <h3 class="font-sans font-semibold text-gray-900 mb-3">Segurança financeira</h3>
            <p class="text-gray-700 leading-relaxed">
              Saber exatamente quanto você precisa, como organizar sua reserva e como não ficar na mão no meio da estrada.
            </p>
          </div>
          <div class="bg-white rounded-2xl shadow-sm p-6">
            <img
              src="/curso-cgdv/IMG_9893.avif"
              alt="Estratégia de renda viajando"
              class="w-full h-40 object-cover rounded-xl mb-5"
              width="400"
              height="160"
              loading="lazy"
              decoding="async"
            />
            <h3 class="font-sans font-semibold text-gray-900 mb-3">Estratégia de renda</h3>
            <p class="text-gray-700 leading-relaxed">
              Criar fontes de renda antes e durante a viagem — online e offline — para sustentar o estilo de vida sem depender de ninguém.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção O Método + Oferta -->
  <section id="oferta" class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div>
          <h2 class="heading-primary mb-6">O Método CGDV</h2>
          <p class="text-gray-700 text-lg leading-relaxed mb-6">
            Um passo a passo prático para você:
          </p>
          <ul class="space-y-3 text-lg text-gray-700 mb-8">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Sair da vida tradicional com segurança</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Organizar seu dinheiro antes de partir</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Criar renda na estrada</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span>Reduzir custos sem sofrimento</span>
            </li>
          </ul>
          <p class="text-gray-500 italic">Sem teoria. Só o que funciona na prática.</p>
        </div>

        <div class="rounded-2xl border-4 border-brand-green p-8 md:p-10 shadow-xl relative">
          <div class="absolute -top-4 left-1/2 transform -translate-x-1/2">
            <span class="bg-brand-green text-white text-sm font-bold px-6 py-2 rounded-full uppercase tracking-wide shadow-lg whitespace-nowrap">
              ⭐ Oferta Especial
            </span>
          </div>
          <div class="flex justify-center mb-6">
            <img
              src="/curso-cgdv/GP015090.avif"
              alt="Método CGDV — Curso Como Ganhar Dinheiro Viajando"
              class="w-full max-w-[260px] h-auto drop-shadow-xl rounded-xl object-cover"
              width="260"
              height="360"
              loading="lazy"
              decoding="async"
            />
          </div>
          <p class="text-gray-500 line-through text-lg mb-2">De R$ 297,00</p>
          <p class="text-3xl md:text-4xl font-serif font-semibold" style="color:#123A2B;">
            Por apenas R$ 247,00
          </p>
          <p class="text-gray-600 mt-2">ou 12x de R$ 25,55</p>

          <ul class="mt-6 space-y-2 text-gray-700 text-sm">
            <li class="flex items-center gap-2"><span style="color:#123A2B;" class="font-bold">✔</span> Método CGDV completo</li>
            <li class="flex items-center gap-2"><span style="color:#123A2B;" class="font-bold">✔</span> Planilhas e checklists prontos</li>
            <li class="flex items-center gap-2"><span style="color:#123A2B;" class="font-bold">✔</span> Templates e ferramentas</li>
            <li class="flex items-center gap-2"><span style="color:#123A2B;" class="font-bold">✔</span> +300 ideias de renda</li>
            <li class="flex items-center gap-2"><span style="color:#123A2B;" class="font-bold">✔</span> Comunidade no WhatsApp</li>
          </ul>

          <div class="mt-8 flex flex-col gap-3">
            <a
              href={checkoutUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary inline-flex items-center justify-center text-center"
            >
              COMEÇAR AGORA
            </a>
            <p class="text-sm text-gray-600 text-center">
              ✓ Acesso imediato • ✓ Garantia de 7 dias
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção O que você vai aprender -->
  <section class="py-16" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="heading-primary mb-8 text-center">
          O que você vai aprender
        </h2>

        <div class="bg-white rounded-2xl shadow-md p-8 md:p-10">
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-lg text-gray-700">Quanto custa viver na estrada (do básico ao confortável)</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-lg text-gray-700">Como montar sua segurança financeira</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-lg text-gray-700">Como gerar renda online e offline</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-lg text-gray-700">Como trabalhar viajando</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 shrink-0 mt-0.5" style="color:#123A2B;" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-lg text-gray-700">Como reduzir custos sem se explorar</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção Quem somos / Prova -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
        <div class="relative">
          <img
            src="/curso-cgdv/IMG_0515.avif"
            alt="Renan e Millena — Naturerota"
            class="w-full rounded-2xl shadow-lg object-cover"
            style="max-height: 520px;"
            width="600"
            height="520"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <h2 class="heading-primary mb-6">Antes de virar curso, já era realidade</h2>
          <div class="text-gray-700 text-xl leading-relaxed">
            <p>
              Oi, somos o Renan e a Millena.
            </p>
            <p class="mt-4">
              Mais de 8 meses na estrada. Mais de 20.000 km rodados. Erros reais que viraram método.
            </p>
            <p class="mt-4">
              O Método CGDV não é teoria. É o que fizemos — e o que você pode replicar com segurança, mesmo começando do zero.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Comparação Sem vs Com -->
  <section class="py-16" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="heading-primary mb-10 text-center">A diferença que faz o método</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Sem o método -->
          <div class="bg-white rounded-2xl p-8 border-2 border-gray-200 shadow-sm">
            <h3 class="text-xl font-semibold text-red-600 mb-6 flex items-center gap-2">
              <span>❌</span> Sem o método
            </h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">•</span> Tentativa e erro</li>
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">•</span> Gastos desnecessários</li>
              <li class="flex items-start gap-2"><span class="text-red-400 mt-0.5">•</span> Insegurança financeira</li>
            </ul>
          </div>
          <!-- Com o método -->
          <div class="rounded-2xl p-8 border-2 shadow-sm" style="border-color:#123A2B; background-color:#f0f7f2;">
            <h3 class="text-xl font-semibold mb-6 flex items-center gap-2" style="color:#123A2B;">
              <span>✅</span> Com o método
            </h3>
            <ul class="space-y-3 text-gray-700">
              <li class="flex items-start gap-2"><span style="color:#123A2B;" class="mt-0.5 font-bold">•</span> Caminho validado</li>
              <li class="flex items-start gap-2"><span style="color:#123A2B;" class="mt-0.5 font-bold">•</span> Clareza total</li>
              <li class="flex items-start gap-2"><span style="color:#123A2B;" class="mt-0.5 font-bold">•</span> Mais segurança</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção FAQ -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto">
        <h2 class="heading-primary mb-10">FAQ (Perguntas frequentes)</h2>

        <div class="space-y-4">
          <details class="bg-gray-50 rounded-2xl p-6 shadow-sm">
            <summary class="cursor-pointer font-sans font-semibold text-gray-900">
