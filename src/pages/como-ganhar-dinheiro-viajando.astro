          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_6080.avif"
              alt="Vida na estrada"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_0515.avif"
              alt="Viajando pelo Brasil"
              class="w-full h-48 object-cover"
              width="400"
              height="192"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="rounded-xl overflow-hidden shadow-md">
            <img
              src="/curso-cgdv/IMG_8890.avif"
