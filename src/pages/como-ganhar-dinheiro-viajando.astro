---
import Layout from "../layouts/Layout.astro";


const checkoutUrl = "https://pay.hotmart.com/K105077150A?checkoutMode=10&bid=1774553429551";
---

<Layout
  title="Como Ganhar Dinheiro Viajando | Método CGDV | Naturerota"
  description="Aprenda a viver na estrada com segurança financeira. O Método CGDV é um passo a passo prático para sair da vida tradicional, organizar seu dinheiro e criar renda na estrada — mesmo começando do zero."
  type="product"
  hideNavigation={true}
  hideFooter={true}
  preloadLcpImage="/curso-cgdv/IMG_6564.avif"
>
  <!-- Hero + VSL -->
  <section class="relative overflow-visible" style="background-color: #123A2B;">
    <div class="relative container mx-auto px-4 pt-14 pb-10 md:pt-16 md:pb-12">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-white font-serif font-semibold text-3xl md:text-4xl lg:text-5xl leading-tight">
          Viva na estrada com segurança financeira
        </h1>
        <p class="mt-4 text-white/80 text-lg md:text-xl leading-relaxed">
          Mesmo começando do zero e sem depender da internet
        </p>

        <!-- Vídeo VSL com player customizado -->
        <div id="vsl-wrapper" class="mt-8 relative w-full rounded-2xl overflow-hidden shadow-2xl" style="padding-bottom: 56.25%;">
          <!-- iframe do YouTube (IFrame API) -->
          <div id="vsl-player" class="absolute inset-0 w-full h-full"></div>

          <!-- Overlay "Clique para ouvir" -->
          <div id="vsl-overlay" class="absolute inset-0 flex flex-col items-center justify-center cursor-pointer z-10" style="background: rgba(0,0,0,0.38);">
            <div style="background: rgba(30,60,48,0.82); border-radius: 16px; padding: 24px 36px; display: flex; flex-direction: column; align-items: center; gap: 10px; backdrop-filter: blur(2px);">
              <!-- Ícone mudo -->
              <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                <line x1="23" y1="9" x2="17" y2="15"></line>
                <line x1="17" y1="9" x2="23" y2="15"></line>
              </svg>
              <p style="color:white; font-weight:700; font-size:1.1rem; margin:0;">Seu vídeo já começou</p>
              <p style="color:rgba(255,255,255,0.85); font-size:1rem; margin:0;">Toque para ouvir</p>
            </div>
          </div>

          <!-- Controles customizados (play/pause + restart) -->
          <div id="vsl-controls" class="absolute bottom-0 left-0 right-0 z-20 flex items-center gap-4 px-4 py-3" style="background: linear-gradient(to top, rgba(0,0,0,0.6), transparent); opacity:0; transition: opacity 0.3s;">
            <!-- Play/Pause -->
            <button id="vsl-playpause" aria-label="Play/Pause" style="background:none; border:none; cursor:pointer; padding:4px; display:flex; align-items:center;">
              <svg id="icon-pause" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white">
                <rect x="6" y="4" width="4" height="16"></rect>
                <rect x="14" y="4" width="4" height="16"></rect>
              </svg>
              <svg id="icon-play" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="white" style="display:none;">
                <polygon points="5 3 19 12 5 21 5 3"></polygon>
              </svg>
            </button>
            <!-- Restart -->
            <button id="vsl-restart" aria-label="Reiniciar" style="background:none; border:none; cursor:pointer; padding:4px; display:flex; align-items:center;">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="1 4 1 10 7 10"></polyline>
                <path d="M3.51 15a9 9 0 1 0 .49-4.5"></path>
              </svg>
            </button>
            <!-- Barra de progresso simples -->
            <div id="vsl-progress-bg" style="flex:1; height:4px; background:rgba(255,255,255,0.3); border-radius:2px; cursor:pointer;" title="Progresso">
              <div id="vsl-progress-bar" style="height:100%; background:#87A48E; border-radius:2px; width:0%; transition: width 0.5s linear;"></div>
            </div>
          </div>
        </div>

        <script is:inline>
          (function() {
            // Carrega a API do YouTube
            var tag = document.createElement('script');
            tag.src = 'https://www.youtube.com/iframe_api';
            document.head.appendChild(tag);

            var player;
            var unmuted = false;
            var progressTimer;

            window.onYouTubeIframeAPIReady = function() {
              player = new YT.Player('vsl-player', {
                videoId: 'Uvnv1sVRmpE',
                playerVars: {
                  autoplay: 1,
                  mute: 1,
                  controls: 0,
                  rel: 0,
                  modestbranding: 1,
                  playsinline: 1,
                  disablekb: 1,
                  fs: 0,
                  iv_load_policy: 3,
                },
                events: {
                  onReady: onPlayerReady,
                  onStateChange: onPlayerStateChange,
                }
              });
            };

            function onPlayerReady(event) {
              event.target.playVideo();
              startProgressTimer();
              showControls();
            }

            function onPlayerStateChange(event) {
              var iconPlay  = document.getElementById('icon-play');
              var iconPause = document.getElementById('icon-pause');
              if (event.data === YT.PlayerState.PLAYING) {
                if (iconPlay)  iconPlay.style.display  = 'none';
                if (iconPause) iconPause.style.display = '';
                startProgressTimer();
              } else if (event.data === YT.PlayerState.PAUSED || event.data === YT.PlayerState.ENDED) {
                if (iconPlay)  iconPlay.style.display  = '';
                if (iconPause) iconPause.style.display = 'none';
                clearInterval(progressTimer);
              }
            }

            // Overlay: primeiro toque desmuta, toque seguinte pausa/retoma
            var overlay = document.getElementById('vsl-overlay');
            if (overlay) {
              overlay.addEventListener('click', function() {
                if (!unmuted) {
                  unmuted = true;
                  if (player) player.unMute();
                  overlay.style.display = 'none';
                }
              });
            }

            // Play/Pause
            var btnPlayPause = document.getElementById('vsl-playpause');
            if (btnPlayPause) {
              btnPlayPause.addEventListener('click', function() {
                if (!player) return;
                var state = player.getPlayerState();
                if (state === YT.PlayerState.PLAYING) {
                  player.pauseVideo();
                } else {
                  player.playVideo();
                }
              });
            }

            // Restart
            var btnRestart = document.getElementById('vsl-restart');
            if (btnRestart) {
              btnRestart.addEventListener('click', function() {
                if (!player) return;
                player.seekTo(0, true);
                player.playVideo();
                if (!unmuted) {
                  unmuted = true;
                  player.unMute();
                  var ov = document.getElementById('vsl-overlay');
                  if (ov) ov.style.display = 'none';
                }
              });
            }

            // Barra de progresso
            function startProgressTimer() {
              clearInterval(progressTimer);
              progressTimer = setInterval(function() {
                if (!player || typeof player.getCurrentTime !== 'function') return;
                var duration = player.getDuration();
                var current  = player.getCurrentTime();
                if (duration > 0) {
                  var pct = (current / duration) * 100;
                  var bar = document.getElementById('vsl-progress-bar');
                  if (bar) bar.style.width = pct + '%';
                }
              }, 500);
            }

            // Mostrar controles ao passar o mouse / tocar
            function showControls() {
              var controls = document.getElementById('vsl-controls');
              var wrapper  = document.getElementById('vsl-wrapper');
              if (!controls || !wrapper) return;
              var hideTimer;
              function show() {
                controls.style.opacity = '1';
                clearTimeout(hideTimer);
                hideTimer = setTimeout(function() { controls.style.opacity = '0'; }, 3000);
              }
              wrapper.addEventListener('mousemove', show);
              wrapper.addEventListener('touchstart', show, { passive: true });
            }
          })();
        </script>

        <div class="mt-8">
          <a
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center text-center"
            style="background-color: #87A48E; border-color: #87A48E;"
          >
            COMEÇAR AGORA
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Seção Identificação -->
  <section class="pt-16 pb-12 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-6xl mx-auto">
        <!-- Números de Credibilidade -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
          <div class="text-center">
            <p class="text-4xl md:text-5xl font-serif font-semibold" style="color:#123A2B;">+8</p>
