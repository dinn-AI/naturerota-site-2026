---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Compra confirmada! | Naturerota"
  description="Obrigado pela compra. Seu ebook está a caminho do seu e-mail."
  type="website"
  robots="noindex, nofollow"
  hideNavigation={true}
  hideFooter={true}
>
  <section class="min-h-screen flex items-center justify-center py-16 md:py-24" style="background-color: #FFF8F2;">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <!-- Ícone de sucesso -->
        <div class="w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-8" style="background-color: #123A2B;">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>

        <p class="text-sm md:text-base font-sans text-gray-500 uppercase tracking-widest mb-3">
          Pedido confirmado 🎉
        </p>
        <h1 class="text-3xl md:text-5xl font-serif font-semibold text-gray-900 leading-tight">
          Compra realizada com sucesso!
        </h1>
        <p class="mt-6 text-lg md:text-xl text-gray-700 leading-relaxed">
          Seu ebook está chegando no seu e-mail em até 5 minutos.<br />
          Verifique a <strong>caixa de entrada e o spam</strong>.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/"
            class="btn-primary inline-flex items-center justify-center text-center"
          >
            Voltar para o site
          </a>
          <a
            href="https://instagram.com/naturerota"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-secondary inline-flex items-center justify-center text-center"
          >
            Seguir no Instagram
          </a>
        </div>

        <p class="mt-12 text-base text-gray-500">
          Um abraço,<br />
          <strong>Renan e Millena | Naturerota</strong>
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    /**
     * PÁGINA DE OBRIGADO — EVENTO PURCHASE META PIXEL
     * 
     * Captura dados do comprador da URL (Hotmart pode passar parâmetros após compra)
     * e dispara o evento Purchase com correspondência avançada.
     * 
     * Parâmetros suportados na URL:
     *   ?buyer_email=email@email.com
     *   ?buyer_name=Nome Completo
     *   ?buyer_phone=11999999999
     *   ?value=57.90          (valor da compra — opcional)
     *   ?product=patagonia    (nome do produto — opcional)
     */
    (function() {
      try {
        var urlParams = new URLSearchParams(window.location.search);

        // Captura dados do comprador
        var buyerEmail = urlParams.get('buyer_email') || urlParams.get('email') || '';
        var buyerPhone = urlParams.get('buyer_phone') || urlParams.get('phone') || '';
        var buyerName  = urlParams.get('buyer_name')  || urlParams.get('name')  || '';
        var purchaseValue = parseFloat(urlParams.get('value') || '57.90');

        // Persiste no localStorage para futuras visitas (melhora correspondência avançada)
        if (buyerEmail) window.localStorage.setItem('user_email', buyerEmail.toLowerCase().trim());
        if (buyerPhone) window.localStorage.setItem('user_phone', buyerPhone.replace(/\D/g, ''));

        // Evita disparar Purchase duplicado em refresh
        var dedupeKey = 'nr_purchase_fired_' + (buyerEmail || window.location.pathname);
        try {
          if (sessionStorage.getItem(dedupeKey)) return;
          sessionStorage.setItem(dedupeKey, '1');
        } catch(e) {}

        // Monta objeto de correspondência avançada — só inclui campos com valor real
        function buildMatchData() {
          var match = {};
          var em = window.localStorage.getItem('user_email');
          var ph = window.localStorage.getItem('user_phone');
          if (em) match.em = em;
          if (ph) match.ph = ph;
          if (buyerName) {
            var parts = buyerName.trim().split(' ');
            if (parts[0]) match.fn = parts[0];
            if (parts.length > 1) match.ln = parts[parts.length - 1];
          }
          return match;
        }

        // Dispara o evento Purchase assim que o fbq estiver disponível
        function firePurchase() {
          if (typeof window.fbq !== 'function') return;

          var matchData = buildMatchData();
          var event_id = 'purchase_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);

          // Re-init com dados do comprador (correspondência avançada)
          window.fbq('init', '1398654025074894', matchData);
          window.fbq('track', 'Purchase', {
            value: purchaseValue,
            currency: 'BRL',
            event_id: event_id
          });

          // Também envia via CAPI (server-side) para deduplicação
          var capiUserData = { client_user_agent: navigator.userAgent };
          if (matchData.em) capiUserData.em = matchData.em;
          if (matchData.ph) capiUserData.ph = matchData.ph;
          if (matchData.fn) capiUserData.fn = matchData.fn;
          if (matchData.ln) capiUserData.ln = matchData.ln;

          fetch('/api/fbevents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              event_name: 'Purchase',
              event_id: event_id,
              event_source_url: window.location.href,
              custom_data: { value: purchaseValue, currency: 'BRL' },
              user_data: capiUserData
            })
          }).catch(function(err) { console.error('Erro CAPI Purchase:', err); });
        }

        // Aguarda o pixel estar disponível (estratégia lazy do Layout)
        var attempts = 0;
        var checkPixel = setInterval(function() {
          attempts++;
          if (typeof window.fbq === 'function' || attempts > 60) {
            clearInterval(checkPixel);
            if (typeof window.fbq === 'function') firePurchase();
          }
        }, 500);

      } catch(e) { console.error('Erro Purchase script:', e); }
    })();
  </script>
</Layout>
