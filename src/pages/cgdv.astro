---
import Layout from "../layouts/Layout.astro";

const checkoutUrl = "https://pay.hotmart.com/K105077150A?checkoutMode=10&bid=1774553429551";
---

<Layout
  title="Método CGDV | Como Ganhar Dinheiro Viajando | Naturerota"
  description="Saia da vida que te impede de viver — mesmo achando que não tem dinheiro pra viajar. O Método CGDV é o caminho para sua liberdade financeira na estrada."
  type="product"
  hideNavigation={true}
  hideFooter={true}
  preloadLcpImage="/curso-cgdv/vsl-thumb-700w.webp"
>
  <!-- Timer Fixo -->
  <div class="fixed top-0 left-0 right-0 z-50 py-2 px-4 text-center shadow-lg" style="background-color: #CA7B50; color: white;">
    <p class="text-sm md:text-base font-bold">
      🔥 Oferta especial - De R$ 497 por R$ 257 SÓ HOJE! 
      <span id="timer-count" class="ml-2 font-mono bg-black/30 px-2 py-0.5 rounded">15:00</span>
    </p>
  </div>

  <script is:inline>
    (function() {
      const timerId = 'cgdv-countdown-v2';
      let timeLeft = localStorage.getItem(timerId);
      
      if (!timeLeft || timeLeft <= 0) {
        timeLeft = 15 * 60; // 15 minutos
      } else {
        timeLeft = parseInt(timeLeft, 10);
      }

      function updateDisplay() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        const display = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
        const el = document.getElementById('timer-count');
        if (el) el.innerText = display;
      }

      const timerInterval = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          timeLeft = 15 * 60; // Loop simples para marketing
        }
        localStorage.setItem(timerId, timeLeft);
        updateDisplay();
      }, 1000);

      updateDisplay();
    })();
  </script>

  <!-- Hero Section (Logo + Apresentação) -->
  <section class="pt-20 pb-16 bg-[#123A2B] text-white overflow-hidden">
    <div class="container mx-auto px-4">
      <!-- Logo -->
      <div class="flex justify-center mb-12">
        <img 
          src="/curso-cgdv/LOGO-METODO-CGDV.svg" 
          alt="Logo Método CGDV" 
          class="h-24 md:h-32 w-auto invert brightness-0"
          style="filter: brightness(0) invert(1);"
          width="300"
          height="353"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="max-w-4xl mx-auto text-center" id="apresentacao">
        <h1 class="text-[28px] md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4">
          Saia da vida que te impede de viver — mesmo achando que não tem dinheiro pra viajar.
        </h1>
        <p class="text-xl md:text-2xl text-white/80 mb-10">
          "Muita gente ganhou dinheiro viajando depois que descobriu isso"
        </p>

        <div class="max-w-4xl mx-auto">
          <!-- Vídeo VSL (Facade) -->
          <div id="vsl-wrapper" class="relative w-full rounded-2xl overflow-hidden shadow-2xl mb-10 mx-auto max-w-3xl" style="padding-bottom: 56.25%; background: #000; cursor: pointer;">
            <div id="vsl-facade" class="absolute inset-0 w-full h-full z-10" onclick="loadYouTube()">
              <img 
                src="/curso-cgdv/vsl-thumb-700w.webp"
                srcset="
                  /curso-cgdv/vsl-thumb-400w.webp 400w,
                  /curso-cgdv/vsl-thumb-700w.webp 700w
                "
                sizes="(max-width: 768px) 100vw, 700px"
                alt="Assistir vídeo"
                class="w-full h-full object-cover opacity-60"
                width="700" 
                height="394"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
              <div id="vsl-overlay" class="absolute inset-0 flex flex-col items-center justify-center">
                <div style="background: rgba(30,60,48,0.82); border-radius: 16px; padding: 24px 36px; display: flex; flex-direction: column; align-items: center; gap: 10px; backdrop-filter: blur(2px);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <p style="color:white; font-weight:700; font-size:1.1rem; margin:0;">Tocar vídeo</p>
                </div>
              </div>
            </div>
            <div id="vsl-player" class="absolute inset-0 w-full h-full" style="display: none;"></div>
          </div>

          <a
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center text-center w-full max-w-md py-5 text-base sm:text-xl tracking-tight font-bold rounded-2xl shadow-2xl hover:scale-105 transition-transform"
            style="background-color: #A85E35; border-color: #A85E35;"
          >
            QUERO SAIR DESSA VIDA
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- [DOR + IDENTIFICAÇÃO] -->
  <section class="py-20 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="space-y-6 text-xl md:text-3xl font-serif text-gray-800 leading-tight">
          <p>Você acorda cansado.</p>
          <p>Trabalha em algo que não gosta.</p>
          <p>Volta exausto.</p>
          <p class="font-bold py-4">E repete.</p>
          <p class="text-gray-500 italic">Enquanto isso…</p>
          <p class="text-3xl md:text-4xl text-brand-green font-bold">a vida passa.</p>
        </div>
        
        <div class="mt-12">
          <img
            src="/curso-cgdv/IMG_9893-800w.avif"
            srcset="/curso-cgdv/IMG_9893-400w.avif 400w, /curso-cgdv/IMG_9893-800w.avif 800w"
            sizes="(max-width: 768px) 100vw, 800px"
            alt="Reflexão sobre a vida"
            class="w-full max-w-2xl mx-auto rounded-2xl shadow-xl border-4 border-[#FFF8F2]"
            width="800"
            height="1067"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- [QUEBRA DE CRENÇA] -->
  <section class="py-20 bg-[#123A2B] text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center space-y-8">
        <h2 class="text-2xl md:text-5xl font-serif leading-tight">
          Você acha que o problema é dinheiro.
        </h2>
        <p class="text-4xl md:text-6xl font-bold text-[#CA7B50]">
          Não é.
        </p>
        <p class="text-2xl md:text-3xl text-white/80">
          É falta de um plano.
        </p>
      </div>
    </div>
  </section>

  <!-- [NOVA POSSIBILIDADE] -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-5xl font-serif text-center mb-12 text-[#123A2B]">
          Existe outro jeito:
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="space-y-6">
            <div class="flex items-center gap-4 text-xl md:text-2xl text-gray-700">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center text-brand-green">✓</span>
              <p>Trabalhar de onde quiser</p>
            </div>
            <div class="flex items-center gap-4 text-xl md:text-2xl text-gray-700">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center text-brand-green">✓</span>
              <p>Ganhar dinheiro na estrada</p>
            </div>
            <div class="flex items-center gap-4 text-xl md:text-2xl text-gray-700">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center text-brand-green">✓</span>
              <p>Viver com menos… e melhor</p>
            </div>
            <div class="flex items-center gap-4 text-xl md:text-2xl text-gray-700">
              <span class="flex-shrink-0 w-10 h-10 rounded-full bg-brand-green/10 flex items-center justify-center text-brand-green">✓</span>
              <p>Não depender de férias ou chefe</p>
            </div>
          </div>
          <div class="relative">
            <img
              src="/curso-cgdv/IMG_9198-800w.avif"
              srcset="/curso-cgdv/IMG_9198-400w.avif 400w, /curso-cgdv/IMG_9198-800w.avif 800w"
              sizes="(max-width: 768px) 100vw, 500px"
              alt="Liberdade na estrada"
              class="rounded-3xl shadow-2xl object-cover w-full h-full min-h-[300px]"
              width="800"
              height="1067"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    function loadYouTube() {
      // Remove facade
      document.getElementById('vsl-facade').style.display = 'none';
      document.getElementById('vsl-player').style.display = 'block';
      
      // Load YouTube API if not already loaded
      if (!window.YT) {
        var tag = document.createElement('script');
        tag.src = 'https://www.youtube.com/iframe_api';
        var firstScriptTag = document.getElementsByTagName('script')[0];
        firstScriptTag.parentNode.insertBefore(tag, firstScriptTag);
      } else {
        onYouTubeIframeAPIReady();
      }
    }

    window.onYouTubeIframeAPIReady = function() {
      new YT.Player('vsl-player', {
        videoId: 'Uvnv1sVRmpE',
        playerVars: { 
          autoplay: 1, 
          mute: 0, 
          controls: 1, 
          rel: 0, 
          modestbranding: 1, 
          playsinline: 1 
        },
        events: {
          'onReady': function(event) {
            event.target.playVideo();
          }
        }
      });
    };
  </script>

  <!-- [O QUE VOCÊ VAI TER] -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl md:text-5xl font-serif text-center mb-12 text-[#123A2B]">
          O que você vai ter:
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl border-2 border-[#f0f7f2] bg-[#f0f7f2]/30 flex items-start gap-4">
            <span class="text-2xl">✔</span>
            <p class="text-xl text-gray-800">Quanto precisa pra começar</p>
          </div>
          <div class="p-6 rounded-2xl border-2 border-[#f0f7f2] bg-[#f0f7f2]/30 flex items-start gap-4">
            <span class="text-2xl">✔</span>
            <p class="text-xl text-gray-800">Como gerar renda antes de sair</p>
          </div>
          <div class="p-6 rounded-2xl border-2 border-[#f0f7f2] bg-[#f0f7f2]/30 flex items-start gap-4">
            <span class="text-2xl">✔</span>
            <p class="text-xl text-gray-800">Fontes de renda (online e offline)</p>
          </div>
          <div class="p-6 rounded-2xl border-2 border-[#f0f7f2] bg-[#f0f7f2]/30 flex items-start gap-4">
            <span class="text-2xl">✔</span>
            <p class="text-xl text-gray-800">Como gastar menos vivendo mais</p>
          </div>
          <div class="p-6 rounded-2xl border-2 border-[#f0f7f2] bg-[#f0f7f2]/30 flex items-start gap-4 md:col-span-2">
            <span class="text-2xl">✔</span>
            <p class="text-xl text-gray-800">Plano pra não voltar atrás</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- [PROVA / CONTRASTE] -->
  <section class="py-20 bg-[#FFF8F2]">
    <div class="container mx-auto px-4">
      <div class="max-w-5xl mx-auto text-center">
        <h2 class="text-2xl md:text-5xl font-serif text-[#123A2B] mb-6">
          Enquanto você espera férias…
        </h2>
        <p class="text-2xl md:text-3xl text-gray-600 mb-12">
          Tem gente comum vivendo isso.
        </p>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-16">
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 italic text-lg text-gray-700">
            "Sem dinheiro sobrando."
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 italic text-lg text-gray-700">
            "Sem sorte."
          </div>
          <div class="bg-white p-8 rounded-3xl shadow-sm border border-gray-100 italic text-lg text-gray-700">
            "Só com o método certo."
          </div>
        </div>

        <!-- Depoimentos de Alunos -->
        <h3 class="text-2xl font-bold mb-10 text-[#123A2B]">Resultados dos nossos alunos:</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <img src="/depoimentos-curso-CGDV/comentario-09.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
          <img src="/depoimentos-curso-CGDV/comentario-10.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
          <img src="/depoimentos-curso-CGDV/comentario-11.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
          <img src="/depoimentos-curso-CGDV/comentario-12.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
          <img src="/depoimentos-curso-CGDV/comentario-13.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
          <img src="/depoimentos-curso-CGDV/comentario-14.webp" alt="Depoimento Aluno" class="rounded-2xl shadow-lg w-full h-auto" width="479" height="205" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- [OFERTA] -->
  <section class="py-24 bg-white" id="oferta">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto rounded-[3rem] border-8 border-[#123A2B] shadow-2xl relative">
        <div class="absolute -top-6 left-1/2 -translate-x-1/2 z-10 w-full max-w-[200px] flex justify-center">
          <div class="absolute inset-0 bg-[#A85E35]/40 rounded-full animate-ping"></div>
          <div class="relative bg-[#A85E35] text-white px-8 py-3 rounded-full font-bold tracking-wider whitespace-nowrap shadow-lg">
            OFERTA ÚNICA
          </div>
        </div>
        
        <div class="p-8 md:p-14 text-center">
          <h2 class="text-2xl md:text-5xl font-serif text-[#123A2B] mb-8">Comece hoje sua nova jornada</h2>
          
          <div class="flex flex-col items-center gap-4 mb-10">
            <div class="bg-[#123A2B] rounded-3xl p-8 text-white w-full max-w-sm">
              <span class="text-white/70 text-xl line-through mb-4 block">De R$ 497</span>
              <p class="text-xl mb-4">Por apenas</p>
              <p class="text-6xl font-bold mb-2">12x R$ 26,58</p>
              <p class="text-lg text-white/70">ou R$ 257 à vista SÓ HOJE!</p>
            </div>
          </div>

          <a
