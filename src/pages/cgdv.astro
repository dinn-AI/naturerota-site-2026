              <span>Mais vida</span>
            </li>
          </ul>
        </div>
        <div class="relative">
          <img src="/curso-cgdv/IMG_6289.avif" alt="Vida livre" class="rounded-[2rem] shadow-2xl border-8 border-white" width="3024" height="4032" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <!-- [CTA FINAL] -->
  <section class="py-24 bg-[#123A2B] text-white">
    <div class="container mx-auto px-4 text-center">
      <div class="max-w-3xl mx-auto space-y-10">
        <h2 class="text-3xl md:text-5xl font-serif leading-tight">
          Ou você continua preso… ou muda hoje.
        </h2>
        
        <a
          href={checkoutUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary inline-flex items-center justify-center text-center w-full max-w-md py-5 text-base sm:text-xl tracking-tight font-bold rounded-2xl shadow-[0_0_40px_rgba(255,255,255,0.3)] hover:scale-110 transition-transform"
          style="background-color: white; color: #123A2B; border-color: white;"
        >
          QUERO COMEÇAR AGORA 👉
        </a>

        <div class="pt-12 text-center space-y-4">
          <p class="text-[#CA7B50] font-bold text-2xl">Último aviso:</p>
          <p class="text-3xl md:text-4xl font-serif italic text-white/90">
            O tempo que você tá perdendo… não volta. 🚀
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ e Segurança Simples -->
  <section class="py-16 bg-white border-t border-gray-100">
    <div class="container mx-auto px-4 text-center">
      <p class="text-gray-500 mb-8 max-w-2xl mx-auto">
        Pagamento 100% Seguro via Hotmart. Acesso imediato no seu e-mail logo após a confirmação.
      </p>
      <div class="flex justify-center mt-8">
        <img 
          src="/compra-segura-hotmart.webp" 
          alt="Compra Segura Hotmart" 
          class="w-full max-w-2xl h-auto"
          width="1000" 
          height="300"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

</Layout>
