---
import Layout from "../layouts/Layout.astro";

const checkoutUrl = "https://pay.hotmart.com/K105077150A?checkoutMode=10&bid=1774553429551";
---

<Layout
  title="Método CGDV | Como Ganhar Dinheiro Viajando | Naturerota"
  description="Saia da vida que te impede de viver — mesmo achando que não tem dinheiro pra viajar. O Método CGDV é o caminho para sua liberdade financeira na estrada."
  type="product"
  hideNavigation={true}
  hideFooter={true}
  preloadLcpImage="/curso-cgdv/vsl-thumb-700w.webp"
>
  <!-- Timer Fixo -->
  <div class="fixed top-0 left-0 right-0 z-50 py-2 px-4 text-center shadow-lg" style="background-color: #CA7B50; color: white;">
    <p class="text-sm md:text-base font-bold">
      🔥 Oferta especial - De R$ 297 por R$ 147 SÓ HOJE! 
      <span id="timer-count" class="ml-2 font-mono bg-black/30 px-2 py-0.5 rounded">15:00</span>
    </p>
  </div>

  <script is:inline>
    (function() {
      const timerId = 'cgdv-countdown-v2';
      let timeLeft = localStorage.getItem(timerId);
      
      if (!timeLeft || timeLeft <= 0) {
        timeLeft = 15 * 60; // 15 minutos
      } else {
        timeLeft = parseInt(timeLeft, 10);
      }

      function updateDisplay() {
        const minutes = Math.floor(timeLeft / 60);
        const seconds = timeLeft % 60;
        const display = `${minutes}:${seconds < 10 ? '0' : ''}${seconds}`;
        const el = document.getElementById('timer-count');
        if (el) el.innerText = display;
      }

      const timerInterval = setInterval(() => {
        timeLeft--;
        if (timeLeft <= 0) {
          timeLeft = 15 * 60; // Loop simples para marketing
        }
        localStorage.setItem(timerId, timeLeft);
        updateDisplay();
      }, 1000);

      updateDisplay();
    })();
  </script>

  <!-- Hero Section (Logo + Apresentação) -->
  <section class="pt-20 pb-16 bg-[#123A2B] text-white overflow-hidden">
    <div class="container mx-auto px-4">
      <!-- Logo -->
      <div class="flex justify-center mb-12">
        <img 
          src="/curso-cgdv/LOGO-METODO-CGDV.svg" 
          alt="Logo Método CGDV" 
          class="h-24 md:h-32 w-auto invert brightness-0"
          style="filter: brightness(0) invert(1);"
          width="300"
          height="353"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="max-w-4xl mx-auto text-center" id="apresentacao">
        <h1 class="text-[28px] md:text-5xl lg:text-6xl font-serif text-white leading-tight mb-4">
          Saia da vida que te impede de viver — mesmo achando que não tem dinheiro pra viajar.
        </h1>
        <p class="text-xl md:text-2xl text-white/80 mb-10">
          "Muita gente ganhou dinheiro viajando depois que descobriu isso"
        </p>

        <div class="max-w-4xl mx-auto">
          <!-- Vídeo VSL (Facade) -->
          <div id="vsl-wrapper" class="relative w-full rounded-2xl overflow-hidden shadow-2xl mb-10 mx-auto max-w-3xl" style="padding-bottom: 56.25%; background: #000; cursor: pointer;">
            <div id="vsl-facade" class="absolute inset-0 w-full h-full z-10" onclick="loadYouTube()">
              <img 
                src="/curso-cgdv/vsl-thumb-700w.webp"
                srcset="
                  /curso-cgdv/vsl-thumb-400w.webp 400w,
                  /curso-cgdv/vsl-thumb-700w.webp 700w
                "
                sizes="(max-width: 768px) 100vw, 700px"
                alt="Assistir vídeo"
                class="w-full h-full object-cover opacity-60"
                width="700" 
                height="394"
                fetchpriority="high"
                loading="eager"
                decoding="async"
              />
              <div id="vsl-overlay" class="absolute inset-0 flex flex-col items-center justify-center">
                <div style="background: rgba(30,60,48,0.82); border-radius: 16px; padding: 24px 36px; display: flex; flex-direction: column; align-items: center; gap: 10px; backdrop-filter: blur(2px);">
                  <svg xmlns="http://www.w3.org/2000/svg" width="52" height="52" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <polygon points="5 3 19 12 5 21 5 3"></polygon>
                  </svg>
                  <p style="color:white; font-weight:700; font-size:1.1rem; margin:0;">Tocar vídeo</p>
                </div>
              </div>
            </div>
            <div id="vsl-player" class="absolute inset-0 w-full h-full" style="display: none;"></div>
          </div>

          <a
            href={checkoutUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary inline-flex items-center justify-center text-center w-full max-w-md py-5 text-base sm:text-xl tracking-tight font-bold rounded-2xl shadow-2xl hover:scale-105 transition-transform"
            style="background-color: #A85E35; border-color: #A85E35;"
          >
            QUERO SAIR DESSA VIDA
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- [DOR + IDENTIFICAÇÃO] -->
  <section class="py-20 bg-white overflow-hidden">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <div class="space-y-6 text-xl md:text-3xl font-serif text-gray-800 leading-tight">
          <p>Você acorda cansado.</p>
          <p>Trabalha em algo que não gosta.</p>
          <p>Volta exausto.</p>
          <p class="font-bold py-4">E repete.</p>
          <p class="text-gray-500 italic">Enquanto isso…</p>
          <p class="text-3xl md:text-4xl text-brand-green font-bold">a vida passa.</p>
        </div>
        
        <div class="mt-12">
          <img
            src="/curso-cgdv/MockupCGDV-mar.avif"
            alt="Mockup do Método CGDV no mar"
            class="w-full max-w-2xl mx-auto rounded-2xl"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- [QUEBRA DE CRENÇA] -->
