              <span class="text-white font-bold text-sm">02</span>
            </div>
            <h3 class="text-xl md:text-2xl font-serif text-[#123A2B] leading-snug">
              O que tem dentro
            </h3>
            <!-- Stats rápidos -->
            <div class="flex gap-4 flex-wrap">
              <div class="bg-[#f0f7f2] rounded-xl px-4 py-2 text-center">
                <p class="text-2xl font-bold text-[#123A2B]">6</p>
