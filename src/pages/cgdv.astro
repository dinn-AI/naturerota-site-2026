    </div>
  </section>

  <!-- [GARANTIA] -->
  <section class="py-20 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto flex flex-col md:flex-row items-center gap-12 p-10 rounded-[3rem] bg-[#123A2B] text-white">
        <div class="w-48 h-48 md:w-64 md:h-64 flex-shrink-0 relative">
          <div class="absolute inset-0 bg-white/10 rounded-full animate-ping"></div>
          <div class="relative w-full h-full bg-[#CA7B50] rounded-full flex flex-col items-center justify-center border-8 border-white shadow-2xl">
            <span class="text-5xl md:text-6xl font-black">30</span>
            <span class="text-xl md:text-2xl font-bold">DIAS</span>
