        link.addEventListener('click', function() {
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'InitiateCheckout',
            ecommerce: { currency: 'BRL', value: 147.00, items: [{ item_id: 'K105077150A', item_name: 'Método CGDV — Curso', price: 147.00, quantity: 1 }] }
          });
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'InitiateCheckout', { currency: 'BRL', value: 147.00, content_ids: ['K105077150A'], content_name: 'Método CGDV — Curso', content_type: 'product', num_items: 1 });
          }
