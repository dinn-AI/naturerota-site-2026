          >
            QUERO COMEÇAR AGORA
          </a>
          
          <img src="/curso-cgdv/Trabalho-remoto.avif" alt="Curso CGDV" class="w-full max-w-md mx-auto rounded-2xl mb-8" width="1920" height="1080" loading="lazy" decoding="async" />

          <!-- [BÔNUS] -->
          <div class="bg-[#FFF8F2] p-8 rounded-3xl text-left border-2 border-dashed border-[#CA7B50]">
            <h3 class="text-2xl font-bold text-[#CA7B50] mb-6 mb-6">🎁 Você ainda leva de presente:</h3>
            <ul class="space-y-4 text-lg text-gray-700">
